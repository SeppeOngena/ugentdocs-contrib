\ProvidesExplPackage{ugentdocs-contrib}{2026-10-03}{0.1}
  {Unofficial ugentdocs customizations and extensions}

\bool_new:N \l__ugcontrib_suppreport_bool
\bool_new:N \l__ugcontrib_citelinks_bool
\bool_new:N \l__ugcontrib_pdfmeta_bool
\bool_new:N \l__ugcontrib_rotatedpage_bool
\bool_new:N \l__ugcontrib_sectiontitlestyle_bool

\keys_define:nn { ugentdocs-contrib }
{
  supplementary       .bool_set:N = \l__ugcontrib_supplementary_bool ,
  fullcitationlinks   .bool_set:N = \l__ugcontrib_citelinks_bool ,
  ugentdocspdfmeta    .bool_set:N = \l__ugcontrib_pdfmeta_bool ,
  rotatedpage         .bool_set:N = \l__ugcontrib_rotatedpage_bool ,
  sectiontitlestyle   .bool_set:N = \l__ugcontrib_sectiontitlestyle_bool,

}
\ProcessKeyOptions [ ugentdocs-contrib ]

\bool_if:NT \l__ugcontrib_citelinks_bool {
  % Makes the full citation the link (e.g., ``Jekyll & Hyde (1886)'')
  % instead of just the year
  % Maintainer: Seppe Ongena
  \AddToHook { package/biblatex/after }  {
    % \cite, \parencite, \autocite all route through this macro in authoryear.cbx
    \renewbibmacro*{cite}{%
      \iffieldundef{shorthand}
      {\ifthenelse{\ifnameundef{labelname}\OR\iffieldundef{labelyear}}
        {\printtext[bibhyperref]{\usebibmacro{cite:label}}%
          \setunit{\addspace}%
          \usebibmacro{cite:reinit}}
        {\printtext[bibhyperref]{%
            \printnames{labelname}%
            \setunit{\nameyeardelim}%
            \usebibmacro{cite:labeldate+extradate}}}}
      {\usebibmacro{cite:shorthand}}}

    % \textcite
    \DeclareCiteCommand{\textcite}{}
    {\printtext[bibhyperref]{%
        \printnames{labelname}%
        \addspace\bibopenparen
        \usebibmacro{cite:labeldate+extradate}%
        \bibcloseparen}}
    {\textcitedelim}
    {\usebibmacro{textcite:postnote}}
  }
}


\bool_if:NT \l__ugcontrib_pdfmeta_bool{
  % Adds a pdf creator metadata
  % Maintainer: Seppe Ongena
  \hypersetup { pdfcreator = { LaTeX~with~the~ugentdocs~package } }
}

\NewDocumentCommand \addugentdocsfootnote { }{
  % Adds a footnote for the article class
  % Maintainer: Seppe Ongena
  \bool_if:NT \l__ugcontrib_pdfmeta_bool {
    \begingroup
    \let \thefootnote \relax
    \long \def \@makefntext ##1 { \parindent \z@ \noindent ##1 }
    \footnotetext
    { Typeset~using~the~\textrm{\LaTeX{}}~\texttt{ugentdocs}~package. }
    \endgroup
  }
}

\bool_if:NT \l__ugcontrib_rotatedpage_bool {
  % Landscape pages: rotated in the viewer for digital output (pdflscape),
  % body-only rotation for camera-ready print (lscape).
  % Maintainer: Seppe Ongena
  \bool_lazy_and:nnTF
  { \bool_if_exist_p:N \l__ugentdocs_cameraready_bool }
  { \l__ugentdocs_cameraready_bool }
  {
    \RequirePackage{lscape}
  }{
    \RequirePackage{pdflscape}
  }
}

\bool_if:NT \l__ugcontrib_supplementary_bool {
  % Adds supplementary styling (e.g. Figure S1)
  % Can turn the whole report class into a supplementary information document
  % if \supplementarymaterial is called in the preamble
  % Maintainer: Seppe Ongena

  \providecommand*\@journal{}
  \providecommand*\journal[1]{\gdef\@journal{#1}}
  \providecommand*\@doi{}
  \providecommand*\doi[1]{\gdef\@doi{#1}}
  \providecommand\@grants{}
  \providecommand\grants[1]{\gdef\@grants{#1}}

  \NewDocumentCommand \supplementarymaterial { } {
    % Redefine chapters and sections
    \setcounter{figure}{0}
    \setcounter{table}{0}
    \setcounter{section}{0}
    \setcounter{equation}{0}
    \let \thefigureWithoutS \thefigure
    \renewcommand \thefigure { S \thefigureWithoutS }
    \let \thetableWithoutS \thetable
    \renewcommand \thetable { S \thetableWithoutS }
    \let \theequationWithoutS \theequation
    \renewcommand \theequation { S \theequationWithoutS }
    \ifdefined \c@chapter
      \renewcommand \thechapter { S\arabic{chapter} }
      \renewcommand \thesection
        { \ifnum \c@chapter > \z@ \thechapter . \else S\fi \arabic{section} }
    \else
      \renewcommand \thesection { S\arabic{section} }
    \fi
    % unique hyperref anchors, so links don't jump back to the main text
    \def \theHfigure   { supp. \thefigure }
    \def \theHtable    { supp. \thetable }
    \def \theHsection  { supp. \thesection }
    \def \theHequation { supp. \theequation }
    \def \theHchapter  { supp. \thechapter }

    % New dictionary keys
    \ugentdocsdictset{english}{
      pages      = Pages,
      figures    = Figures,
      tables     = Tables,
      suppinfo   = Supplementary~information,
      includedin = Are~included~in~this
    }

    \ugentdocsdictset{dutch}{
      pages      = Paginas,
      figures    = Figuren,
      tables     = Tabellen,
      suppinfo   = Supplementaire~informatie,
      includedin = Zijn~inbegrepen~in~deze
    }

    \RequirePackage[figure,table]{totalcount}

    % New cover
    \renewcommand{\@frontcover}{
      \begin{tikzpicture}[inner~sep=0pt, outer~sep=0pt]
        \clip (0,0) rectangle (\@PW,\@PH);
        % Cover body
        \@coverbody
      \end{tikzpicture}
    }
    \renewcommand{\@coverbody}{
      \node[anchor=north~west, inner~sep=0pt, text~width=\paperwidth-\@MTLR-\gridunit,
      minimum~height=22.05cm, align=flush~left] at (\@MTLR,\@HT)
      {%
        \raggedright
        \begin{spacing}{2.5}
          {\fontsize{25}{30}\selectfont\color{covertitlecolor}\bfseries
            \MakeUppercase{\uline{\@title}}}
        \end{spacing}

        \vskip 1em

        {\fontsize{20}{24}\selectfont\color{covertitlecolor}
          \MakeUppercase{\@subtitle}}

        \vskip 2em

        \begingroup\color{coverdatacolor}
        {\fontsize{16}{20}\selectfont\translatekey{suppinfo}}

        \ifseqempty{authors}{
          \vskip 10em
        }{
          \vskip 5em
          {\fontsize{14}{17}
          \__ugentdocs_printauthorlist:}
          \vskip 5em
        }


        \ifseqempty{affiliations}{}{
          {\fontsize{10}{12}\selectfont
            \__ugentdocs_printaffiliationlist:}
          \vskip 2 em
        }
        \endgroup
      };
      \node[anchor=south~west, inner~sep=0pt, text~width=\paperwidth-\@MTLR-\gridunit,
       align=flush~left] at (\@MTLR,\gridunit)
        {%
        \__ugentdocs_printauthorfootnote:{}

        \begingroup
        \let \thefootnote \relax
        \long \def \@makefntext ####1 { \parindent \z@ \noindent ####1 }
        \footnotetext{
          \par \ztotpages{}~\translatekey[lowercase]{pages},
          {}~\totalfigures{}~\translatekey[lowercase]{figures}
          \translatekey{andlist}~\totaltables{}~\translatekey[lowercase]{tables}
          {}~\translatekey[lowercase]{includedin}~\translatekey[lowercase]{suppinfo}.
        }
        \endgroup
      };
    }
  }
}

\bool_if:NT \l__ugcontrib_sectiontitlestyle_bool {
  \providecommand \sectionname { Section }
  \addto \captionsenglish { \renewcommand \sectionname { Section } }
  \addto \captionsdutch   { \renewcommand \sectionname { Sectie } }
  \renewcommand{\@titlestylesection}{
    \exp_args:Nx \str_case:nnF { \l__ugentdocs_chaptitlestyle_tl } {
      { plain } {
        \titleformat{\section}
        [block] % shape
        {\fontsize{16}{19} \selectfont \color{titlecolor} \bfseries } % format
        {\thesection. \ } % the label
        { 0ex } %separator space
        {\MakeUppercase{\uline{##1}} } %before code
        [\@addthumb] %after code

        \titleformat{name=\section,numberless}
        [block] % shape
        {\fontsize{16}{19} \selectfont \color{titlecolor} \bfseries } % format
        {} % the label
        {0ex}%separator space
        {\uline{\MakeUppercase{##1}}} %before code

        % Change the spacing above the chapter. This is left - above - below
        %\titlespacing*{\section}{0pt}{-3em}{12pt}

        \renewcommand{\@titlestyleappendix}{ % Adds "appendix" to title
          \titleformat{\section}
          [display] % shape
          {\fontsize{18}{22}\selectfont\color{titlecolor}} % format
          {\MakeUppercase{\sectiontitlename\ \thesection}} % the label
          {-2ex} %separator space
          {\fontsize{24}{32}\selectfont\bfseries\raggedright\MakeUppercase{%
              \uline{####1}}} %before code
          [\@addthumb] %after code
        }
      }
      { fancy } {
        \titleformat{\section}
        [display] % shape
        {}{}{0pt} % format, label, sep (unused: box+number are drawn manually)
        {%
          \noindent
          \begin{tikzpicture}[remember~picture]
            \useasboundingbox (0,0) rectangle (\linewidth, -3\gridunit);

            % Number coloured box: top at the current position, right edge at the page edge (+bleed)
            \node[fill=titlecolor, minimum~height=3\gridunit, minimum~width=
            4\gridunit+\the\hoffset, inner~sep=0pt, anchor=north~east]
            (numbox)
            at ([xshift=\the\hoffset] 0,0 -| current~page.east) {};

            % Section number
            \node[white, font=\fontsize{70}{70}\selectfont\bfseries, anchor=center]
            at ([xshift=1.5\gridunit]numbox.west |- numbox.center) {\thesection};

            % Section name
            \node[white, font=\bfseries\normalsize, rotate=90, anchor=center, inner~sep=2pt]
            at ([xshift=3.5\gridunit]numbox.west |- numbox.center) {\sectionname};

          \end{tikzpicture}%
          \group_begin:
          \skip_set:Nn \topsep    { \dim_eval:n { \topsep } }
          \skip_set:Nn \partopsep { \dim_eval:n { \partopsep } }
          \skip_set:Nn \parskip   { \dim_eval:n { \parskip } }
          \vspace*{10pt}
          \begin{flushright}
            \color{titlecolor}\huge\bfseries##1%
          \end{flushright}%
          \vspace*{-10pt}%
          {\color{titlecolor}\rule{\textwidth}{1pt}}
          \group_end:
        }
        [\@addthumb] %after code

        \titleformat{name=\section,numberless}
        [block]
        {}{}{0pt}
        {%
          \group_begin:
          \skip_set:Nn \topsep    { \dim_eval:n { \topsep } }
          \skip_set:Nn \partopsep { \dim_eval:n { \partopsep } }
          \skip_set:Nn \parskip   { \dim_eval:n { \parskip } }
          \begin{flushright}
            \color{titlecolor}\huge\bfseries##1%
          \end{flushright}%
          \vspace*{-10pt}%
          {\color{titlecolor}\rule{\textwidth}{1pt}}
          \group_end:
        }

        \titlespacing*{\section}{0pt}{0pt}{20pt}

        % No thumb on section page
        \bool_if:NT \l__ugentdocs_thumbs_bool {
          \apptocmd{\@addthumb}{\stopthumb}{}{}
          \AddToHook{shipout/foreground}{\continuethumb}
        }

      }
      { fancycompact} {
        \titleformat{\section}
        [display] % shape
        {}{}{0pt} % format, label, sep (unused: box+number are drawn manually)
        {%
          \noindent
          \begin{tikzpicture}[remember~picture]
            \useasboundingbox (0,0) rectangle (\linewidth, -3\gridunit);

            % Number coloured box: top at the current position, right edge at the page edge (+bleed)
            \node[fill=titlecolor, minimum~height=3\gridunit, minimum~width=
            4\gridunit+\the\hoffset, inner~sep=0pt, anchor=north~east]
            (numbox)
            at ([xshift=\the\hoffset] 0,0 -| current~page.east) {};

            % Section number
            \node[white, font=\fontsize{70}{70}\selectfont\bfseries, anchor=center]
            at ([xshift=1.5\gridunit]numbox.west |- numbox.center) {\thesection};

            % Section name
            \node[white, font=\bfseries\normalsize, rotate=90,
            anchor=center,inner~sep=2pt]
            at ([xshift=3.5\gridunit]numbox.west |- numbox.center) {\sectionname};

            % Section title
            \node[titlecolor, font=\huge\bfseries,
            anchor=south~east, align=flush~right, text~width=0.85\textwidth]
            at ([xshift=-10pt,yshift=10pt]numbox.west |- numbox.south) {##1};

            % Rule
            \draw[titlecolor, line~width=1pt]
            ([xshift=-\the\hoffset]current~page~text~area.west |- numbox.south)
            -- (numbox.south~east);
          \end{tikzpicture}%
        }
        [\@addthumb] %after code

        \titleformat{name=\section,numberless}
        [block]
        {}{}{0pt}
        {%
          \group_begin:
          \skip_set:Nn \topsep    { \dim_eval:n { \topsep } }
          \skip_set:Nn \partopsep { \dim_eval:n { \partopsep } }
          \skip_set:Nn \parskip   { \dim_eval:n { \parskip } }
          \begin{flushright}
            \color{titlecolor}\huge\bfseries##1%
          \end{flushright}%
          \vspace*{-10pt}%
          {\color{titlecolor}\rule{\textwidth}{1pt}}
          \group_end:
        }

        \titlespacing*{\chapter}{0pt}{0pt}{20pt}

        % No thumb on chapter page
        \bool_if:NT \l__ugentdocs_thumbs_bool {
          \apptocmd{\@addthumb}{\stopthumb}{}{}
          \AddToHook{shipout/foreground}{\continuethumb}
        }
      }
      { uantwerpen } {
        % Adapted from uantwerpendocs v4.12, (C) Walter Daems, LPPL 1.3c
        \titleformat { \section } [display]
        { \normalfont \raggedleft }
        {
          \makebox[0pt][l]{ \color{titlecolor} \rule[-0.4em]{10cm}{1.8em} }
          \textcolor{white}{ \LARGE \bfseries {}~\sectionname~ }
          \raisebox{-24pt}{ \@@_ua_sec_num: }
          \hspace*{-8pt}
        }
        { 0pt }
        { \huge \bfseries \color{titlecolor} \rule[-0.5ex]{0pt}{2.6ex} ~ ##1 }
        [ { \titlerule[1pt] } ]
        \titleformat { name = \section , numberless } [block]
        { \normalfont \raggedleft \LARGE \bfseries \color{titlecolor} }
        { } { 0pt }
        { \rule[-0.5ex]{0pt}{2.6ex} ~ ##1 }
        [ { \titlerule[1pt] } ]
        \titlespacing* { \section } { 0pt } { 1ex } { 5pt }
      }
      { legacyplain }{
        \titleformat{\section}[block]
        {\Large\bfseries}{}{20pt}{%
          \makebox[0pt][r]{\@legacychapshape{\thesection}{white}{\fontsize{16}{18}\selectfont}}%
          ##1%
        }[\@addthumb]

        \titleformat{name = \section, numberless}[block]
        {\Large\bfseries}{}{0pt}{%
          \makebox[0pt][r]{\@legacychapshape{0}{ugent@main}{\large}}%
          ##1%
        }
        %\titlespacing*{\section}{0pt}{-20pt}{10pt}
      }
    }{
      \PackageError{ugentdocs}
      { The~section~styling~specified~is~not~implemented }
      { See~the~ugentdocs~manual. }
    }
  }
  \cs_new_protected:Npn \@@_ua_sec_num: {
    \begin{tikzpicture}
      [ every~node/.style = { font = \fontsize{72}{72} \selectfont \bfseries } ]
      \foreach \a in { 0, 5, ..., 355 }
      { \node [white] at ( { 0.025 * cos(\a) } , { 0.025 * sin(\a) } ) { \thesection }; }
      \node [titlecolor!50] at (0,0) { \thesection };
    \end{tikzpicture}
  }
}